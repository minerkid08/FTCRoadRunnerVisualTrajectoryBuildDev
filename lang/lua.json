{
  "sequentional": {
    "start": "sequentionalAction()",
    "build": ":build()",
    "add": ":add(",
    "addEnd": ")"
  },
  "parallel": {
    "start": "parallelAction()",
    "build": ":build()",
    "add": ":add(",
    "addEnd": ")"
  },
  "trajectory": {
    "start": "trajectoryAction(%.2f, %.2f, %.2f)",
    "indent": false,
    "build": ":build()",
    "setTangent": ":setTangent(%.2f)",
    "splineTo": ":splineTo(%.2f, %.2f, %.2f)",
    "splineToConstantHeading": ":splineToConstantHeading(%.2f, %.2f, %.2f)",
    "splineToLinearHeading": ":splineToLinearHeading(%.2f, %.2f, %.2f, %.2f)"
  },
  "custom-action": {
    "format": "%s(%s)",
    "int": "%d",
    "double": "%.2f",
    "bool": "%s",
    "string": "\"%s\""
  }
}
