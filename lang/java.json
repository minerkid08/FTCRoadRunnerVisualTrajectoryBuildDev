{
  "sequentional": {
    "start": "new SequentionalAction(",
    "end": ")"
  },
  "parallel": {
    "start": "new ParallelAction(",
    "end": ")"
  },
  "trajectory": {
    "start": "drive.actionBuilder(new Pose2d(%.2f, %.2f, Math.toRadians(%.2f))",
    "build": ".build()",
    "setTangent": ".setTangent(Math.toRadians(%.2f))",
    "splineTo": ".splineTo(new Vector2d(%.2f, %.2f), Math.toRadians(%.2f))",
    "splineToConstantHeading": ".splineToConstantHeading(new Vector2d(%.2f, %.2f), Math.toRadians(%.2f))",
    "splineToLinearHeading": ".splineToLinearHeading(new Pose2d(%.2f, %.2f, Math.toRadians(%.2f)), Math.toRadians(%.2f))"
  },
  "custom-action": {
    "format": "new %s(%s)",
    "int": "%d",
    "double": "%.2f",
    "bool": "%s",
    "string": "\"%s\""
  }
}
